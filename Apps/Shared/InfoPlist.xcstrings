    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anchor uses Bluetooth to pair your nearby iPhone and Mac, detect proximity, and securely sync task status when network links are unavailable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anchor 使用蓝牙配对附近的 iPhone 与 Mac、检测距离，并在网络连接不可用时安全同步任务状态。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anchor uses local and peer-to-peer network connections to securely sync your paired iPhone and Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anchor 使用本地网络和点对点连接，在已配对的 iPhone 与 Mac 之间安全同步。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
