    "demo.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenarios inject raw events and signals into the same reducers used by production."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场景只向生产环境共用的状态机注入原始事件和信号。"
          }
        }
      }
    },
