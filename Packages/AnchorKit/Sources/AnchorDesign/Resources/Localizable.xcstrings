{
  "sourceLanguage" : "en",
  "strings" : {
  "return.saved.records": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Mac is disconnected. Showing saved records."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Mac 未连接，先显示已保存的记录。"
        }
      }
    }
  },
  "return.no.received.changes": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "No changes received yet. This summary updates as records arrive."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "暂未收到离开期间的变化，新记录同步后会自动更新。"
        }
      }
    }
  },
  "return.no.task.records": {
