    "source.setup.codex.folder-panel.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow local keyword matching of Codex conversations. Review or change suggested tasks before tracking. Conversation text is not stored; only the opening of each conversation's latest request and reply reaches your iPhone, over the local link."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权读取 Codex 会话文件夹。Anchor 会按任务关键词查找相关会话，供你确认或修改；匹配时读取的文字不保存，只有每段对话最近一次请求与回复的开头会经本地连接显示在 iPhone 上。"
          }
        }
      }
    },
